{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-task",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 天気の地域・ニュースの配信元（変更したい場合はここを編集）
  "vars": {
    "WEATHER_LABEL": "東京",
    "WEATHER_LAT": "35.6812",
    "WEATHER_LON": "139.7671",
    "NEWS_FEED_URL": "https://www3.nhk.or.jp/rss/news/cat0.xml"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-task",
      "database_id": "3fbb25eb-f7b3-4a4f-8733-fc7efb84b2bf",
      "migrations_dir": "migrations"
    }
  ]
}
