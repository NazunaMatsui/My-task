{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-task",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  // 取り込み待ちの反映・保存期間を過ぎた記録の削除（15分ごと）
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-task",
      "database_id": "3fbb25eb-f7b3-4a4f-8733-fc7efb84b2bf",
      "migrations_dir": "migrations"
    }
  ]
}
